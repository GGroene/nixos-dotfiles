[global]
    origin = top-right
    offset = 10x10
    width = 300
    height = 300
    padding = 12
    horizontal_padding = 12
    frame_width = 2
    frame_color = "#6272a4"
    separator_color = frame
    font = JetBrainsMono Nerd Font 10
    corner_radius = 6

[urgency_low]
    background = "#282a36"
    foreground = "#f8f8f2"
    timeout = 5

[urgency_normal]
    background = "#282a36"
    foreground = "#f8f8f2"
    timeout = 8

[urgency_critical]
    background = "#282a36"
    foreground = "#ff5555"
    frame_color = "#ff5555"
    timeout = 0
